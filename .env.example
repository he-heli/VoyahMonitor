# Phone number in international format, e.g. +79991234567
VOYAH_PHONE=+7

# Paths (defaults work for local and Docker)
VOYAH_SESSION_PATH=data/session.json
VOYAH_NETWORK_CAPTURE_PATH=data/network_capture.json
VOYAH_DB_PATH=data/voyah_monitor.db

# Base URL of VOYAH Assist web app
VOYAH_BASE_URL=https://app.voyahassist.ru

# Optional: comma-separated read-only API paths discovered after login
# Example: /api/v1/vehicles,/api/v1/telemetry
VOYAH_ALLOWED_GET_PATHS=

# Optional: comma-separated read-only POST paths (only if API uses POST for reads)
VOYAH_ALLOWED_POST_PATHS=

# Telegram bot (optional, for bot command)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Telemetry polling interval in seconds
TELEGRAM_POLL_INTERVAL=300
